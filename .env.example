# Copy to .env and adjust. .env is gitignored; this file is committed.

# --- Postgres ---
POSTGRES_USER=ceynex
POSTGRES_PASSWORD=ceynex_dev
POSTGRES_DB=ceynex
# Bump if 5432 is already taken on your machine (another project's postgres, a
# system install). `make up` fails with "port is already allocated" if it is.
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- Neo4j ---
# Each member runs their own stack: bump these if you share a machine (R8).
NEO4J_PASSWORD=ceynex_dev_pw
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# --- Qdrant (policy-document vector store, D10) ---
# Same per-member port convention as neo4j: bump if you share a machine.
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ceynex_policy
# Set to `off` to run the system exactly as it behaved before policy retrieval
# existed. `make eval-policy-baseline` does this to produce the before-figures.
CEYNEX_POLICY_RETRIEVAL=on

# --- News sidecar (GDELT DOC 2.0, D11) ---
# No key line here on purpose: GDELT DOC 2.0 is open, and a GDELT_API_KEY=
# placeholder would imply one is needed and send the next person looking for it.
# Its own Qdrant collection, never ceynex_policy — unvetted headlines must not
# sit behind the filters that produce citable policy evidence (SRS 3.1.4).
QDRANT_NEWS_COLLECTION=ceynex_news
# Serve news at all. `off` leaves the endpoints up but always degraded.
CEYNEX_NEWS=on
# Run the hourly refresher in *this* process. Separate from the switch above so
# a second deployment can serve the shared snapshot without also calling GDELT.
CEYNEX_NEWS_REFRESH=on

# --- Adminer ---
# Bump if 8080 is taken — it very often is. `make up` fails the same way postgres
# does: "port is already allocated".
ADMINER_PORT=8080

# --- UN Comtrade (R2: register at https://comtradedeveloper.un.org/) ---
COMTRADE_API_KEY=

# --- OpenAI (LLMReasoningClient + LLM router) ---
OPENAI_API_KEY=
# Model ids live in config/llm.yaml, not here.

# --- OpenRouter (config/llm.yaml: fallback provider, R5) ---
# Free-tier key from https://openrouter.ai/keys. Used once per call, only
# after the OpenAI call fails/times out or the spend cap is hit — not a
# primary provider swap.
OPENROUTER_API_KEY=

# --- Paths ---
CEYNEX_DATA_DIR=./data
CEYNEX_MODELS_DIR=./models

# --- Conversational layer (deviations D12-D15) ---
# All three default to "on" and all three are absent-safe: unset behaves exactly
# as set-to-on, so a deployment that never adds them keeps working. Set to
# "off" to remove a surface entirely, which is what makes "answers are unchanged
# with this feature off" a claim anyone can check.
#
# CEYNEX_CHAT=off      -> no /api/chat/* at all; POST /api/query as it always was
# CEYNEX_CLARIFY=off   -> chat still works, but never asks a clarifying question
# CEYNEX_WEB_SEARCH=off-> no outbound web search on any provider
# CEYNEX_SCENARIO=off  -> no /api/scenario/*; the agent still simulates from questions
#
# CEYNEX_CITATIONS is the odd one out: it defaults to *off*, because turning it
# on changes the prompt every answer is written from. docs/EVALUATION.md §8
# measures what an unmeasured prompt change is worth, so this exists to make
# enabling it a comparison rather than a leap.
CEYNEX_CHAT=on
CEYNEX_CLARIFY=on
CEYNEX_WEB_SEARCH=on
CEYNEX_SCENARIO=on
CEYNEX_CITATIONS=off

# --- Tavily (general web search, D14) ---
# Optional, and absent means the feature is simply off — there is no keyless
# fallback. An earlier draft of this file promised one; a scraped keyless
# provider is fragile and widens the untrusted surface for very little, so
# `from_settings()` returns None without a key (D14). CEYNEX_WEB_SEARCH=off is
# still the separate, explicit kill switch, and the one that makes "answers are
# byte-identical to the pre-web-search system" checkable.
#
# Tavily is preferred because it returns extracted page content rather than link
# snippets, which is what makes a web result citable rather than only linkable.
TAVILY_API_KEY=

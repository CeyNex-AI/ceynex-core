.env
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.pytest-tmp/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Data and artefacts — never committed, except reference tables, fixtures,
# and each connector's PROFILE.md (per .claude/commands/new-connector.md).
# Layered on purpose: a negation can't re-include a file whose parent
# directory is itself ignored, so `data/raw/<source>/` is un-ignored first
# and only its contents are ignored again one level down.
data/raw/*
!data/raw/*/
data/raw/*/*
!data/raw/*/PROFILE.md
data/staging/
data/parquet/
# Saved model artifacts, at the repo root only. `ceynex/models/` is the package
# that writes them and must stay tracked — a bare `models/` matches both.
/models/
!ceynex/data/reference/
!tests/**/fixtures/

# LLM prompt-hash cache
.cache/

# Frontend (M3)
web/node_modules/
web/dist/

# Local-only working docs — not this repo's concern.
# Anchored: ceynex/contracts/CLAUDE.md IS tracked, it guards the frozen package.
/CLAUDE.md
CeyNex_plan_updated/
CeyNex_plan.tar.gz

# Governing documents live in the team docs repo, not here (15MB of PDF/DOCX
# that pre-commit's large-file check would reject anyway). Markdown under docs/
# that this repo produces — ARCHITECTURE_DELTA, EVALUATION, DEFERRED — is tracked.
docs/*
!docs/*.md

# `make docs` output. Regenerate with `make docs`; the binaries it reads are not
# in this repo.
docs/_text/

# Notebooks are exploratory/local-only — we don't put them on GitHub.
notebooks/

# Blind coherence rating material. The sheet is generated per session from
# eval_results.json, and the key must never travel with it — a rater who can
# see the key is scoring the machinery, which is the one thing the blinding
# exists to prevent. Regenerate with `make coherence`.
coherence_sheet.csv
coherence_sheet.key.json
coherence_sheet.rubric.txt

# EDB permission/contact documents — personal/admin material, never committed.
/Contact Export Development Board*.html
/Contact Export Development Board*_files/
/Dr.Chathuranga Hettiarachchi*.html
/Dr.Chathuranga Hettiarachchi*_files/
/EDB_Permission_Email.txt
/EDB_Permission_Letter.txt
/CeyNex - EDB Permission Email.docx
/CeyNex - EDB Permission Request Letter.docx

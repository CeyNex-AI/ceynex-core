.env
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Data and artefacts — never committed, except reference tables and fixtures.
# Raw pulls and derived artefacts are never committed, but each source's
# PROFILE.md is. Ignoring `data/raw/*/` as a directory would make that
# impossible — git cannot re-include a file whose parent directory is excluded —
# so the cached payloads are ignored by extension instead.
data/raw/**/*.json
data/raw/**/*.csv
data/raw/**/*.zip
data/raw/**/*.xlsx
data/staging/
data/parquet/
models/
!ceynex/data/reference/
!tests/**/fixtures/

# LLM prompt-hash cache
.cache/

# Frontend (M3)
web/node_modules/
web/dist/

# Local-only working docs — not this repo's concern.
# Anchored: ceynex/contracts/CLAUDE.md IS tracked, it guards the frozen package.
/CLAUDE.md
CeyNex_plan_updated/
CeyNex_plan.tar.gz

# Governing documents live in the team docs repo, not here (15MB of PDF/DOCX
# that pre-commit's large-file check would reject anyway). Markdown under docs/
# that this repo produces — ARCHITECTURE_DELTA, EVALUATION, DEFERRED — is tracked.
docs/*
!docs/*.md

# `make docs` output. Regenerate with `make docs`; the binaries it reads are not
# in this repo.
docs/_text/
